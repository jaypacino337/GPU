# ---------------------------------------------------------------------------
# Client-visible (NEXT_PUBLIC_*). These are bundled into the browser — never put
# a secret here.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLUSTER=devnet

# BLOCKED: the real $PUMPBROKER mint.
NEXT_PUBLIC_TOKEN_MINT=SET_ME

# BLOCKED: load-bearing. Prices are whole tokens scaled by 10^decimals, so a
# wrong value is off by a power of ten. Validated at import, never defaulted.
NEXT_PUBLIC_TOKEN_DECIMALS=SET_ME

# From `anchor keys sync` / the deploy.
NEXT_PUBLIC_PROGRAM_ID=SET_ME

# BLOCKED: wallet that owns pause / airdrop / fee-collect.
NEXT_PUBLIC_ADMIN_WALLET=SET_ME

# Core collection, from scripts/create-collection.ts.
NEXT_PUBLIC_COLLECTION=SET_ME

# Used only to build a parseable RPC URL during prerender. No request is made
# to it at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only. NOT prefixed with NEXT_PUBLIC_, so it never reaches the browser.
# The client talks to /api/rpc, which proxies to this with an allowlist.
# ---------------------------------------------------------------------------

HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
